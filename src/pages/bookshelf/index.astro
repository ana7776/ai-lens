---
import Base from '../../layouts/Base.astro';
import SectionPage from '../../components/SectionPage.astro';
const items = [
  { label:'국내 큐레이션', title:'챗GPT·제미나이·클로드까지 모두를 위한 AI', description:'주요 생성형 AI를 한 권으로 비교하며 입문하기 좋은 책입니다.', meta:'AI 입문 · YES24 연동' },
  { label:'AI 개발', title:'에이전틱 AI와 AI 코딩', description:'에이전트, 도구 호출, 코딩 워크플로를 이해하기 위한 실용 독서 주제입니다.', meta:'개발자 독서' },
  { label:'2026 북리스트', title:'지금 읽을 만한 AI 책 15선', description:'빠르게 바뀌는 AI 시대에 오래 남는 질문과 맥락을 담은 책을 모았습니다.', meta:'해외 큐레이션', href:'https://divbyzero.com/blog/best-ai-books/' },
  { label:'기술과 사회', title:'2026년 최고의 AI 도서', description:'파운데이션 모델, 지정학, 상용화의 흐름을 함께 읽는 추천 목록입니다.', meta:'Five Books 큐레이션', href:'https://fivebooks.com/best-books/the-best-ai-books-in-2026-chatgpt/' },
  { label:'AI 교양', title:'비전공자를 위한 AI 지식', description:'수학과 코딩을 몰라도 AI의 핵심 개념을 따라갈 수 있는 입문 주제입니다.', meta:'AI 입문' },
  { label:'미래 전망', title:'AI가 바꾸는 지식 노동', description:'에이전트 시대에 사람의 역할과 일의 구조가 어떻게 바뀌는지 생각해봅니다.', meta:'깊이 읽기' },
];
---
<Base title="AI 도서" description="AI 입문서, 개발서, 미래 전망서를 큐레이션합니다."><SectionPage kicker="AI BOOKSHELF" title="AI 도서" description="무엇부터 읽을지 고민될 때, AI렌즈가 먼저 읽고 고른 책을 만나보세요." items={items} /></Base>
