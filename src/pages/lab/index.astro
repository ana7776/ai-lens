---
import Base from '../../layouts/Base.astro';
import SectionPage from '../../components/SectionPage.astro';
const items = [
  { label:'초급', title:'RAG 파이프라인 시작하기', description:'문서를 검색하고 답변에 반영하는 기본 구조와 검색 품질의 핵심을 익힙니다.', meta:'따라 하기 가이드', href:'https://cohere.com/blog/agentic-rag' },
  { label:'에이전트 RAG', title:'검색하고 판단하고 다시 찾기', description:'단순 검색을 넘어 질문에 따라 도구와 검색 경로를 선택하는 흐름을 설계합니다.', meta:'아키텍처 가이드', href:'https://blog.starmorph.com/blog/rag-techniques-compared-best-practices-guide' },
  { label:'AI 코딩', title:'스펙 먼저, 코드 나중에', description:'AI에게 바로 코드를 시키기보다 요구사항과 검증 기준을 먼저 만드는 워크플로입니다.', meta:'개발 워크플로', href:'https://addyosmani.com/blog/ai-coding-workflow/' },
  { label:'팀 개발', title:'AI 코딩 에이전트 리뷰 루프', description:'계획, 구현, 테스트, 리뷰를 나눠 AI 코딩 속도를 품질로 연결합니다.', meta:'실전 개발', href:'https://www.jamasoftware.com/blog/ai-engineering-workflow' },
  { label:'로컬 AI', title:'내 PC에서 LLM 돌리기', description:'Ollama와 로컬 모델로 나만의 AI 환경을 구성하고 개인정보 경계를 정합니다.', meta:'실습 가이드' },
  { label:'생산성', title:'프롬프트를 설계하는 법', description:'큰 요청을 작은 단계로 나누고 결과를 검증하는 질문 패턴을 연습합니다.', meta:'워크플로 가이드' },
];
---
<Base title="실전 가이드" description="따라 하면서 배우는 AI 실전 가이드와 튜토리얼입니다."><SectionPage kicker="AI LAB" title="실전 가이드" description="읽고 끝나는 정보가 아니라, 직접 따라 하며 결과를 만드는 가이드입니다." items={items} /></Base>
