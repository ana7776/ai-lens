---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { sections, formatDate } from '../../lib/sections';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => {
    const [section, slug] = guide.id.split('/');
    return { params: { section, slug }, props: { guide } };
  });
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const d = guide.data;
const section = sections[d.section];
const toc = headings.filter((h) => h.depth === 2);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  inLanguage: 'ko',
  datePublished: d.published.toISOString().slice(0, 10),
  dateModified: d.updated.toISOString().slice(0, 10),
  author: { '@type': 'Organization', name: 'AI렌즈 Work 편집팀', url: new URL('/about/', Astro.site).href },
  publisher: { '@type': 'Organization', name: 'AI렌즈 Work' },
  mainEntityOfPage: pageUrl,
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: section.name, item: new URL(section.href, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
  ],
};
const sameDay = d.published.getTime() === d.updated.getTime();
---
<Base title={d.title} description={d.description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  <article class="article-wrap container">
    <nav class="breadcrumbs" aria-label="현재 위치">
      <a href="/">홈</a><span>/</span><a href={section.href}>{section.name}</a><span>/</span><span aria-current="page">{d.label}</span>
    </nav>
    <header class="article-header">
      <span class="article-label">{d.label}</span>
      <h1>{d.title}</h1>
      <p class="article-deck">{d.description}</p>
      <p class="article-meta">
        AI렌즈 Work 편집팀 · 작성 <time datetime={d.published.toISOString().slice(0, 10)}>{formatDate(d.published)}</time>
        {!sameDay && <> · 수정 <time datetime={d.updated.toISOString().slice(0, 10)}>{formatDate(d.updated)}</time></>}
      </p>
    </header>

    {toc.length > 2 && (
      <nav class="toc" aria-label="목차">
        <strong>이 글의 순서</strong>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}

    <div class="article-content"><Content /></div>

    <section class="summary-box" aria-labelledby="summary-title">
      <h2 id="summary-title">핵심 정리</h2>
      <ol>{d.summary.map((line) => <li>{line}</li>)}</ol>
    </section>

    <section class="next-reads" aria-labelledby="next-title">
      <h2 id="next-title">다음에 읽을 글</h2>
      <ul>
        {d.related.map((r) => (
          <li><a href={r.href}><strong>{r.title}</strong><span>{r.why}</span></a></li>
        ))}
      </ul>
    </section>

    <aside class="article-note">
      <strong>읽기 전에 알아둘 점</strong>
      <p>이 글의 프롬프트와 표는 작업 설계를 돕는 예시입니다. AI 서비스의 기능·요금·약관은 바뀔 수 있으므로 사용 전 해당 서비스의 최신 안내를 확인하세요. 오류를 발견하면 <a href="/contact/">문의·오류 제보</a>로 알려주시면 확인 후 수정 기록과 함께 반영합니다.</p>
    </aside>
    <div class="article-next"><a href={section.href}>← {section.name} 목록</a><a href="/editorial-policy/">편집 원칙</a></div>
  </article>
</Base>
<style>
.article-wrap{max-width:820px;padding-top:34px;padding-bottom:10px}
.breadcrumbs{display:flex;flex-wrap:wrap;gap:8px;font-size:12px;color:#74849a}.breadcrumbs a:hover{color:var(--blue);text-decoration:underline}
.article-header{padding:38px 0 28px;border-bottom:1px solid var(--line)}
.article-label{color:var(--blue);font-size:13px;font-weight:800}
.article-header h1{font-size:clamp(28px,4.6vw,44px);line-height:1.3;letter-spacing:-.05em;margin:12px 0}
.article-deck{font-size:17px;color:#53657b;line-height:1.8;margin:0}
.article-meta{font-size:12px;color:#6f7d8d;margin:18px 0 0}
.toc{margin:28px 0 0;padding:18px 22px;background:#fff;border:1px solid var(--line);border-radius:14px}
.toc strong{font-size:13px;color:#34506f}.toc ol{margin:10px 0 0;padding-left:20px;font-size:14px;line-height:1.75;color:#3c5571}.toc a:hover{color:var(--blue);text-decoration:underline}
.article-content{padding:10px 0 8px;font-size:16.5px;line-height:1.9;color:#2b3d53;overflow-wrap:break-word}
.article-content :global(h2){font-size:24px;line-height:1.4;letter-spacing:-.035em;margin:46px 0 14px;color:#142c4b;scroll-margin-top:90px}
.article-content :global(h3){font-size:19px;margin:30px 0 10px;color:#193b62}
.article-content :global(p){margin:0 0 17px}
.article-content :global(ul),.article-content :global(ol){padding-left:24px;margin:0 0 22px}
.article-content :global(li){margin:6px 0}
.article-content :global(a){color:#1f63a0;text-decoration:underline;text-underline-offset:3px}
.article-content :global(blockquote){border-left:4px solid #5590c9;background:#f1f6fb;margin:22px 0;padding:14px 20px;border-radius:0 12px 12px 0}
.article-content :global(blockquote p:last-child){margin:0}
.article-content :global(pre){white-space:pre-wrap;overflow-wrap:anywhere;background:#142d4e !important;color:#f3f7fb;padding:18px 20px;border-radius:12px;font-size:14px;line-height:1.75;margin:18px 0 22px}
.article-content :global(code){font-size:.92em}
.article-content :global(p code),.article-content :global(li code){background:#edf2f7;padding:1px 6px;border-radius:5px}
.article-content :global(table){width:100%;border-collapse:collapse;margin:18px 0 24px;font-size:14.5px;line-height:1.65;display:block;overflow-x:auto}
.article-content :global(th),.article-content :global(td){border:1px solid var(--line);padding:10px 12px;text-align:left;vertical-align:top;min-width:110px}
.article-content :global(th){background:#eef4fa;color:#1d3b5e;font-weight:800}
.article-content :global(tr:nth-child(even) td){background:#fafcfe}
.summary-box{margin:34px 0 0;padding:22px 24px;border-radius:14px;background:#183b61;color:#fff}
.summary-box h2{font-size:17px;margin:0 0 10px}.summary-box ol{margin:0;padding-left:20px;font-size:15px;line-height:1.8}.summary-box li{margin:4px 0}
.next-reads{margin:26px 0 0}.next-reads h2{font-size:18px;margin:0 0 12px}
.next-reads ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.next-reads a{display:block;padding:15px 18px;background:#fff;border:1px solid var(--line);border-radius:12px}
.next-reads a:hover{border-color:#9bb7d4}.next-reads strong{display:block;font-size:15px;color:#173a60}.next-reads span{display:block;font-size:13px;color:var(--muted);margin-top:3px;line-height:1.6}
.article-note{background:#f4f7fa;border:1px solid var(--line);border-radius:14px;padding:18px 22px;margin:26px 0 24px}
.article-note strong{font-size:14px}.article-note p{font-size:13px;line-height:1.75;color:#596b80;margin:6px 0 0}.article-note a{text-decoration:underline}
.article-next{display:flex;justify-content:space-between;gap:16px;border-top:1px solid var(--line);padding:18px 0 34px;font-size:13px;font-weight:700;color:#24517f}.article-next a:hover{text-decoration:underline}
@media(max-width:600px){.article-wrap{padding-top:20px}.article-header{padding:26px 0 22px}.article-deck{font-size:15.5px}.article-content{font-size:16px}.article-content :global(h2){font-size:21px;margin-top:38px}.article-next{flex-direction:column}.summary-box{padding:18px}}
</style>
