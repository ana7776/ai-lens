---
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
const guides=[
  {href:'/work/prompt-structure/',category:'1단계 · 요청문',title:'AI에게 일을 맡기는 요청문, 4요소로 쓰는 법',description:'목표·자료·형식·제약 네 칸으로 요청문을 쓰고, 결과가 어긋날 때 한 칸씩 고치는 방법입니다.',meta:'가장 먼저 읽기'},
  {href:'/work/privacy-before-input/',category:'2단계 · 입력 전 점검',title:'AI에 자료를 넣기 전 확인할 개인정보·기밀 점검표',description:'붙여넣기 전에 지우고, 바꾸고, 묶어야 할 정보를 자료 유형별로 정리했습니다.',meta:'초보자 추천'},
  {href:'/work/meeting-notes/',category:'3단계 · 첫 실전',title:'회의 기록을 실행 항목으로 바꾸는 방법',description:'결정·할 일·담당·기한·미정 항목으로 나누고 원문과 대조하는 첫 실전 과제입니다.',meta:'초보자 추천'},
  {href:'/workflow/review-checklist/',category:'4단계 · 검수',title:'AI 작업 결과를 발행 전에 검수하는 체크리스트',description:'사실·출처·권리·개인정보·표현을 확인하는 마지막 점검표입니다.',meta:'습관 만들기'},
];
---
<Base title="AI 가이드 처음 시작하기" description="AI를 처음 업무와 콘텐츠 제작에 적용하는 사람이 따라 할 수 있는 단계별 시작 가이드입니다.">
<section class="start-hero"><div class="container"><span class="eyebrow">START HERE</span><h1>AI를 어디서부터<br />시작해야 할지 모르겠다면</h1><p>도구를 많이 아는 것보다, 작은 작업 하나를 안전하게 나누고 결과를 확인하는 습관이 먼저입니다. AI렌즈 Work는 혼자 일하는 사람이 바로 적용할 수 있는 업무·콘텐츠 가이드를 제공합니다.</p></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">THREE STEPS</span><h2>처음에는 이 순서로 시작하세요</h2></div></div><div class="steps"><article><b>01</b><h3>작업을 한 문장으로 정의하기</h3><p>“회의록을 요약해줘” 대신 어떤 사람이 어떤 결과를 확인해야 하는지 먼저 적습니다.</p></article><article><b>02</b><h3>입력 자료와 금지 범위 정하기</h3><p>민감정보, 원문 범위, 추측 금지와 같은 경계를 AI에게 명확히 전달합니다.</p></article><article><b>03</b><h3>결과를 원자료와 대조하기</h3><p>숫자·이름·기한·출처를 확인하고, 사람이 최종 승인한 결과만 공유합니다.</p></article></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">RECOMMENDED GUIDES</span><h2>지금 읽을 실전 가이드</h2></div></div><div class="listing-grid">{guides.map((item)=><GuideCard {...item}/>)}</div></div></section>
<section class="section"><div class="container"><div class="notice-strip"><strong>이 사이트의 범위:</strong> AI 도구의 순위나 수익을 약속하지 않습니다. 작업 설계, 검수, 개인정보·권리 확인처럼 독자가 실제로 반복할 수 있는 기준을 다룹니다.</div></div></section>
</Base>
<style>
.start-hero{padding:76px 0 62px;background:linear-gradient(135deg,#eef6fc 0%,#fbfdff 62%,#fff 100%);border-bottom:1px solid var(--line)}.start-hero h1{font-size:clamp(38px,6vw,64px);line-height:1.2;letter-spacing:-.065em;margin:18px 0}.start-hero p{max-width:700px;font-size:18px;color:var(--muted);line-height:1.85;margin:0}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.steps article{background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:var(--shadow)}.steps b{color:var(--blue);font-size:13px}.steps h3{font-size:19px;margin:14px 0 8px}.steps p{font-size:14px;color:var(--muted);line-height:1.75;margin:0}@media(max-width:700px){.start-hero{padding:54px 0 44px}.steps{grid-template-columns:1fr}.start-hero p{font-size:16px}}
</style>
