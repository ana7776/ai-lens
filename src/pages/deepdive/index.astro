---
import Base from '../../layouts/Base.astro';
import SectionPage from '../../components/SectionPage.astro';
const items = [
  { label:'산업 분석', title:'AI 에이전트 시대, 지식 노동의 다음 장면', description:'모델 경쟁을 넘어 실제 일을 수행하는 에이전트가 업무 구조를 어떻게 바꾸는지 분석합니다.', meta:'10분 읽기' },
  { label:'거버넌스', title:'에이전트에게 권한을 어디까지 줄 것인가', description:'도구 호출, 결제, 데이터 접근과 사람의 승인 사이에서 필요한 안전장치를 살펴봅니다.', meta:'12분 읽기', href:'https://news.un.org/en/story/2026/09/1168380' },
  { label:'검색과 추론', title:'RAG는 어디까지 에이전트가 되어야 할까', description:'고정 검색, Agentic RAG, GraphRAG와 긴 컨텍스트의 역할을 비교합니다.', meta:'12분 읽기', href:'https://blog.starmorph.com/blog/rag-techniques-compared-best-practices-guide' },
  { label:'AI 엔지니어링', title:'AI 코딩 속도를 제품 속도로 바꾸는 법', description:'빠른 코드 생성보다 요구사항, 추적성, 검증 루프가 중요한 이유를 살펴봅니다.', meta:'10분 읽기', href:'https://www.jamasoftware.com/blog/ai-engineering-workflow' },
  { label:'안전과 평가', title:'모델이 의도와 다르게 행동할 때', description:'미스얼라인먼트 보고와 평가 체계를 통해 AI 시스템의 실패를 기록하는 방법을 생각합니다.', meta:'10분 읽기', href:'https://openai.com/index/model-misalignment-reporting-framework/' },
  { label:'비즈니스', title:'AI 도입을 숫자와 가치로 연결하기', description:'사용자 수보다 실제 업무 개선과 사업 성과를 측정하는 관점을 정리합니다.', meta:'10분 읽기', href:'https://openai.com/index/how-to-connect-ai-usage-to-business-value/' },
];
---
<Base title="딥다이브" description="AI 산업과 기술 변화의 맥락을 깊이 있게 분석합니다."><SectionPage kicker="AI DEEP DIVE" title="딥다이브" description="빠른 뉴스보다 오래 남는 맥락과 질문을 중심으로 AI를 깊이 읽습니다." items={items} /></Base>
