---
import Base from '../../layouts/Base.astro';import GuideCard from '../../components/GuideCard.astro';
const guides=[{href:'/work/meeting-notes/',category:'회의·기록',title:'회의 기록을 실행 항목으로 바꾸기',description:'결정 사항, 담당자, 기한, 미정 항목을 분리하고 사람이 확인하는 순서를 둡니다.',meta:'프롬프트 예시 포함'},{href:'/work/pdf-review/',category:'문서·리서치',title:'긴 문서를 근거와 함께 검토하기',description:'요약뿐 아니라 근거 위치, 예외 조건, 추가 확인이 필요한 부분을 구조화합니다.',meta:'개인정보 보호 체크'},{href:'/work/email-draft/',category:'이메일·커뮤니케이션',title:'AI로 이메일 초안을 만들 때 확인할 6가지',description:'요청·사실·기한을 먼저 정하고 사람이 발송 전 검수하는 흐름입니다.',meta:'검수 체크리스트'},{href:'/work/ai-review-checklist/',category:'문서·검수',title:'AI가 만든 문서 초안을 검수하는 8단계',description:'사실·범위·개인정보를 원자료와 대조하고 사람이 최종 승인하는 순서입니다.',meta:'발행 전 체크리스트'},{href:'/workflow/weekly-pipeline/',category:'업무 설계',title:'반복 업무를 주간 루틴으로 설계하기',description:'업무를 작은 단계로 나누고 AI가 맡을 부분과 사람이 승인할 부분을 구분합니다.',meta:'통합 워크플로우'}];
---
<Base title="AI 업무 가이드" description="회의, 문서, 리서치 등 혼자 하는 업무에 AI를 안전하게 활용하는 작업 흐름과 검수 기준을 안내합니다."><section class="container"><header class="section-hero"><span class="eyebrow">AI WORK</span><h1>AI 업무 정리</h1><p>AI에게 일을 통째로 넘기기보다, 자료와 결과 형식을 정하고 확인 가능한 작은 단계로 나눕니다. 민감한 자료는 입력 전 공개·보안 조건을 먼저 확인하세요.</p></header><div class="listing-grid">{guides.map((item)=><GuideCard {...item}/>)}</div><div class="notice-strip">업무 결과의 정확성은 입력 자료와 검수에 달려 있습니다. 숫자·이름·기한·결정 사항은 원자료와 대조합니다.</div></section></Base>
