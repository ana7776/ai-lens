---
import Base from '../../layouts/Base.astro';
import SectionPage from '../../components/SectionPage.astro';
const items = [
  { label:'대화형 AI', title:'Claude와 ChatGPT 비교', description:'업무 유형과 사용 목적에 따라 어떤 도구가 맞는지 비교합니다.', meta:'도구 비교' },
  { label:'생산성', title:'지금 써볼 만한 AI 도구', description:'글쓰기, 검색, 디자인, 회의와 자동화를 돕는 서비스를 소개합니다.', meta:'서비스 리뷰' },
  { label:'실험실', title:'직접 써본 사용 후기', description:'기능 목록보다 실제 작업 흐름에서의 장단점을 중심으로 살펴봅니다.', meta:'실사용 테스트' },
];
---
<Base title="AI 도구" description="생성형 AI와 생산성 도구를 비교하고 소개합니다."><SectionPage kicker="AI RADAR" title="AI 도구" description="수많은 AI 서비스 중 내 일에 맞는 도구를 찾을 수 있도록 비교합니다." items={items} /></Base>
