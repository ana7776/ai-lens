---
import Base from '../layouts/Base.astro';
interface Props { title: string; description: string; category: string; categoryHref: string; label?: string; }
const { title, description, category, categoryHref, label = '실전 가이드' } = Astro.props;
---
<Base title={title} description={description}><script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'Article', headline:title, description, author:{ '@type':'Organization', name:'AI렌즈 Work 운영자' }, publisher:{ '@type':'Organization', name:'AI렌즈 Work' }, mainEntityOfPage:Astro.url.href, dateModified:'2026-09-25' })}></script><article class="article-wrap container">
<nav class="breadcrumbs" aria-label="현재 위치"><a href="/">홈</a><span>/</span><a href={categoryHref}>{category}</a><span>/</span><span aria-current="page">{title}</span></nav>
<header class="article-header"><span class="article-label">{label}</span><h1>{title}</h1><p class="article-deck">{description}</p><p class="article-meta">AI렌즈 Work 운영자 · 업데이트 기준 2026년 9월 25일</p></header>
<div class="article-content"><slot /></div>
<aside class="article-note"><strong>읽기 전에</strong><p>아래 내용은 작업 설계를 위한 일반 가이드입니다. 도구의 기능·요금·약관은 바뀔 수 있으므로 실제 사용 전 해당 서비스의 최신 안내를 확인하세요. 예시는 운영자의 실사용 성과를 주장하지 않습니다.</p></aside>
<div class="article-next"><a href={categoryHref}>← {category}의 다른 가이드 보기</a><a href="/editorial-policy/">출처·수정 원칙</a></div>
</article></Base>
<style>
.article-wrap{max-width:860px;padding-top:38px;padding-bottom:22px}.breadcrumbs{display:flex;flex-wrap:wrap;gap:9px;font-size:12px;color:#74849a}.breadcrumbs a:hover{color:var(--blue);text-decoration:underline}.article-header{padding:46px 0 34px;border-bottom:1px solid var(--line)}.article-label{color:var(--blue);font-size:13px;font-weight:800}.article-header h1{font-size:clamp(32px,5vw,48px);line-height:1.28;letter-spacing:-.055em;margin:14px 0}.article-deck{font-size:18px;color:#53657b;line-height:1.8}.article-meta{font-size:12px;color:#7b8796;margin-top:20px}.article-content{padding:34px 0 18px;font-size:16px;line-height:1.9;color:#2e4056}.article-content h2{font-size:25px;line-height:1.4;letter-spacing:-.035em;margin:42px 0 14px;color:#152f50}.article-content h3{font-size:19px;margin:28px 0 10px;color:#193b62}.article-content p{margin:0 0 17px}.article-content ul,.article-content ol{padding-left:24px;margin:0 0 22px}.article-content li{margin:7px 0}.article-content blockquote{border-left:4px solid #5590c9;background:#f1f6fb;margin:22px 0;padding:18px 22px;border-radius:0 12px 12px 0}.article-content pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#142d4e;color:#f3f7fb;padding:20px;border-radius:14px;font-size:14px;line-height:1.7;margin:20px 0}.article-content .checklist{background:#f5f8fb;border:1px solid var(--line);border-radius:14px;padding:20px 24px}.article-note{background:#f4f7fa;border:1px solid var(--line);border-radius:14px;padding:20px 22px;margin:22px 0 30px}.article-note strong{font-size:14px}.article-note p{font-size:13px;line-height:1.7;color:#596b80;margin:6px 0 0}.article-next{display:flex;justify-content:space-between;gap:16px;border-top:1px solid var(--line);padding:20px 0 40px;font-size:13px;font-weight:700;color:#24517f}.article-next a:hover{text-decoration:underline}@media(max-width:600px){.article-wrap{padding-top:24px}.article-header{padding:32px 0 24px}.article-deck{font-size:16px}.article-content{font-size:15px}.article-content h2{font-size:22px;margin-top:34px}.article-next{flex-direction:column}}
</style>
