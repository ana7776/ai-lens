---
interface Item { label: string; title: string; description: string; meta: string; }
interface Props { kicker: string; title: string; description: string; items: Item[]; }
const { kicker, title, description, items } = Astro.props;
---
<section class="section-page"><div class="container"><div class="section-hero"><span>{kicker}</span><h1>{title}</h1><p>{description}</p></div><div class="section-grid">{items.map(item => <article class="section-card"><span>{item.label}</span><h2>{item.title}</h2><p>{item.description}</p><small>{item.meta}</small></article>)}</div></div></section>
<style>
  .section-page{padding:72px 0 100px}.section-hero{max-width:720px;padding:24px 0 42px;border-bottom:1px solid var(--border)}.section-hero>span{font-size:11px;color:var(--primary);font-weight:900;letter-spacing:.14em}.section-hero h1{font-size:42px;line-height:1.25;margin:10px 0 14px;letter-spacing:-.05em}.section-hero p{font-size:15px;color:var(--text-2);line-height:1.8}.section-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:28px}.section-card{background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);padding:24px;min-height:190px;box-shadow:var(--shadow);transition:.2s}.section-card:hover{border-color:var(--border-hover);box-shadow:var(--shadow-lg);transform:translateY(-2px)}.section-card>span{font-size:11px;color:var(--primary);font-weight:800}.section-card h2{font-size:19px;line-height:1.45;margin:12px 0 8px}.section-card p{font-size:13px;color:var(--text-2);line-height:1.7}.section-card small{display:block;color:var(--text-3);font-size:10px;margin-top:18px}@media(max-width:760px){.section-page{padding-top:42px}.section-hero h1{font-size:32px}.section-grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.section-grid{grid-template-columns:1fr}.section-card{min-height:0}}
</style>
