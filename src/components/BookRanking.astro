---
import books from '../data/yes24-books.json';

const partnerCode = import.meta.env.PUBLIC_YES24_PARTNER_CODE?.trim() || '';
const displayPrice = (price: number) => price.toLocaleString('ko-KR');
const yes24Link = (book: { yes24Id?: string; yes24Link?: string }) => {
  const base = book.yes24Link || `https://www.yes24.com/product/goods/${book.yes24Id}`;
  if (!partnerCode) return base;
  return `${base}${base.includes('?') ? '&' : '?'}Partner=${encodeURIComponent(partnerCode)}`;
};
---
<section class="section" id="ranking"><div class="container"><div class="section-heading"><div><span class="section-kicker">BOOKSHELF</span><h2>AI 도서 베스트</h2></div><a href="/bookshelf/" class="more">도서 더보기 →</a></div><div class="bookshelf-grid">{books.map(book => <article class="rank-book"><div class="cover"><img src={book.cover} alt={book.title} loading="lazy"/><b>{book.rank}</b></div><div class="rank-book-body"><span class="book-meta">{book.publisher} · AI 도서</span><h3>{book.title}</h3><p>{book.author}</p><div class="book-bottom"><span>★ {book.rating}</span><strong>₩{displayPrice(book.price)}</strong></div><a href={yes24Link(book)} target="_blank" rel="noopener">YES24 상품 보기 →</a></div></article>)}</div><p class="disclosure">* 도서표지는 YES24 API 키가 등록되면 빌드 시 공식 커버 이미지로 자동 갱신됩니다. 현재는 fallback 이미지와 일반 YES24 상품 링크를 사용합니다.</p></div></section>
<style>
  .bookshelf-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:16px}.rank-book{min-width:0}.cover{position:relative;background:#F0F2F5;border-radius:9px;padding:12px 12px 10px}.cover img{width:100%;height:210px;object-fit:cover;border-radius:3px;box-shadow:var(--shadow-book)}.cover b{position:absolute;top:8px;left:8px;width:25px;height:25px;background:var(--text);color:#fff;border-radius:50%;font-size:12px;display:flex;align-items:center;justify-content:center}.rank-book-body{padding:9px 2px}.book-meta{font-size:10px;color:var(--primary);font-weight:700}.rank-book h3{font-size:13px;line-height:1.45;margin:4px 0}.rank-book p{font-size:11px;color:var(--text-2)}.book-bottom{display:flex;justify-content:space-between;align-items:center;margin:8px 0;color:var(--gold);font-size:11px}.book-bottom strong{font-size:13px}.rank-book-body>a{display:block;text-align:center;background:var(--primary-soft);color:var(--primary);font-size:10px;padding:6px;border-radius:6px;font-weight:700}.disclosure{font-size:10px;color:var(--text-3);margin-top:12px}@media(max-width:1050px){.bookshelf-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:560px){.bookshelf-grid{grid-template-columns:repeat(2,1fr);gap:12px}.cover img{height:190px}}
</style>
